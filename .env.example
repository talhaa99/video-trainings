DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# SMTP settings for assignment email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Petrogas E&P Admin Panel <no-reply@example.com>"

# Optional seed values for `npm run admin:seed`
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_ROLE=super_admin
